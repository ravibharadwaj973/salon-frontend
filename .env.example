# URL of the Parlon backend (server-side only — never exposed to the browser)
API_URL=http://localhost:4000/api/v1

# Public origin of this app, used for links in emails/messages
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the API is reachable from a CUSTOMER'S browser. Only needed when it is
# not the same address as API_URL above (an internal host behind a proxy). It is
# what goes into the <script src> a salon pastes into their own website.
# NEXT_PUBLIC_API_URL=https://api.parlon.in/api/v1
