# ---------- The salon app (parlon.jharavi.in) ----------
#
# Two names are accepted for each address, because Next.js treats NEXT_PUBLIC_*
# (inlined into the browser bundle at build time) and plain server variables as
# different things, and it is easy to set one and not the other. Set BOTH on
# Vercel — the server renders pages with one and the browser follows links
# built from the other.
#
# In a production build a localhost value throws at module load, on the deploy
# screen, instead of timing out as an unexplained 503 in a customer's browser.

# This API, as this server reaches it.
API_URL=http://localhost:4000/api/v1
# In production:  API_URL=https://api.jharavi.in/api/v1

# This API, as a stranger's browser reaches it. It is what goes into the
# <script src> a salon pastes into their own website, so it must be the public
# address even when API_URL points somewhere internal.
NEXT_PUBLIC_API_URL=https://api.jharavi.in/api/v1
# In production:  NEXT_PUBLIC_API_URL=https://api.jharavi.in/api/v1

# Where this app is served to the public. Must match the backend's
# PUBLIC_APP_URL: that is the origin it prints into WhatsApp messages, tracked
# links and QR codes, and a booking page living at two addresses is a support
# call waiting to happen.
PUBLIC_APP_URL=https://parlon.jharavi.in
NEXT_PUBLIC_APP_URL=https://parlon.jharavi.in
# In production:  https://parlon.jharavi.in  (both)
